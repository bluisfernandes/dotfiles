# Check if `eza` is installed
if command -v eza >/dev/null 2>&1; then
    # Aliases for `eza` (a modern replacement for `ls`)
    alias ls='eza --git'                             # List files with Git information
    alias la='eza -a'                               # List all files including hidden
    alias ll='eza -l --group-directories-first --git' # Long format, directories first, Git info
    alias lla='eza -la --group-directories-first --git' # Long format with hidden files, directories first, Git info
    alias lt='eza -T --git-ignore --group-directories-first' # Tree view with Git ignore, directories first
    alias lte='eza -T --git-ignore -I "*env|__pycache__" --group-directories-first' # Tree view with Git ignore, excluding env and __pycache__
    alias ltd='eza -TD --git-ignore'                # Tree view with Git ignore, directories first, no color
    alias lr='eza -ls modified --git'               # List modified files with Git info
else
    # Define color codes
    YELLOW='\033[0;33m'  # Yellow
    RED='\033[0;31m'     # Red
    NC='\033[0m'         # No Color
    echo -e "package '${YELLOW}eza${NC}' not found. ${RED}No 'ls' aliases created${NC}."
fi

# alises to grep and ripgrep
alias grep='grep --color=auto'

# aliases to switch terminals
# alias z='zsh'
# alias b='bash'

# alias to show all alias from this file:
alias aliasb='rg -e ^alias ~/.zaliases -N'

# aliases to see this file with cat or bat
alias aa='bat ~/.zaliases'

# alias to virtual enviroment
alias ac='source ./env/bin/activate'
alias dea='deactivate'

# Git alias for a graphical log view
alias glg='git log --graph --all --oneline'
alias gs='git status'
alias ga='git add'
alias gd='git diff'
alias gc="git commit -m"
alias lg="lazygit"

# Atalhos de Sistema e Configuração
alias update="sudo apt update && sudo apt upgrade -y"
alias reload="source ~/.zshrc"
alias zshconfig="micro ~/.zshrc"
alias aliasconfig="micro ~/.aliases"

# Bitwarden alias
alias bw="flatpak run --command=bw com.bitwarden.desktop"


